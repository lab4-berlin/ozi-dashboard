# PostgreSQL Configuration (dual-run)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_OZI_USER=ozi
POSTGRES_OZI_PASSWORD=ozi_password
POSTGRES_DB=ozi_db2

# Storage & Lakehouse Configuration
OZI_STORAGE_BACKEND=both
OZI_LAKE_CATALOG=/data/ozi_lake.sqlite
OZI_LAKE_DATA_PATH=s3://ozi_lake/ozi_lake/

# S3 / MinIO / Hetzner Settings
# Local MinIO: http://minio:9000 (USE_SSL=false)
# Hetzner: fsn1.your-objectstorage.com (USE_SSL=true)
OZI_S3_ENDPOINT=minio:9000
OZI_S3_BUCKET=ozi_lake
OZI_S3_ACCESS_KEY_ID=minioadmin
OZI_S3_SECRET_ACCESS_KEY=minioadmin
OZI_S3_REGION=fsn1
OZI_S3_USE_SSL=false
OZI_S3_URL_STYLE=path

# DuckDB Resource Management Profiles
OZI_DUCKDB_WRITER_MEM_LIMIT=1GB
OZI_DUCKDB_READER_MEM_LIMIT=512MB
OZI_DUCKDB_WRITER_THREADS=8
OZI_DUCKDB_READER_THREADS=4
OZI_TEMP_DIR=/tmp/lake
OZI_MAX_TEMP_SIZE=4GB

# Docker Compose Overlay Auto-Loading
COMPOSE_FILE=docker-compose.yml:docker-compose.lake.yml
